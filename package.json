{
  "name": "bos-humanstxt-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generate humans.txt for your site directly from a GitHub Action.",
  "author": "Blackout Secure <https://github.com/blackoutsecure>",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackoutsecure/bos-humanstxt-generator.git"
  },
  "bugs": {
    "url": "https://github.com/blackoutsecure/bos-humanstxt-generator/issues"
  },
  "homepage": "https://github.com/blackoutsecure/bos-humanstxt-generator#readme",
  "keywords": [
    "github-action",
    "humans-txt",
    "metadata",
    "static-site",
    "credits",
    "automation"
  ],
  "scripts": {
    "build": "ncc build src/index.js -o dist",
    "prebuild": "npm run validate",
    "prepare": "npm run build",
    "clean": "node -e \"const fs=require('fs');['dist','coverage'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}));\"",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "validate": "npm run lint:check && npm run format:check",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "coverage": "nyc --reporter=html --reporter=text npm test",
    "coverage:ci": "nyc --reporter=lcov npm test",
    "pretest": "npm run build",
    "verify": "npm run validate && npm run test",
    "check": "npm run verify"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.38.1",
    "chai": "^6.2.2",
    "eslint": "^10.4.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "nyc": {
    "exclude": [
      "test/**",
      "dist/**",
      "node_modules/**",
      "eslint.config.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "check-coverage": false,
    "branches": 70,
    "lines": 70,
    "functions": 70,
    "statements": 70
  }
}
