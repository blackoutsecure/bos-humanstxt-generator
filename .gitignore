# Repo-specific ignores. The hub's `common` block covers OS/editor
# noise, secrets, logs, and archives; the `node_ecosystem` service
# covers npm/yarn debug logs and test-output artefacts.

# Dependency lockfiles ignored — this repo does not pin them
yarn.lock
pnpm-lock.yaml

# Build & distribution
public/

# GitHub Actions local testing
.act/
act-*.json
bin/act

# Generated output files (product-specific)
!dist/*.html
!dist/*.txt
!dist/*.xml
!dist/*.xml.gz
!dist/.well-known/
sitemap*.xml*
sitemap*.txt
robots.txt
humans.txt
security.txt
.well-known/security.txt
.well-known/
test-public/
*.old

!event.json
!test/event.json


# >>> managed-file-sync:common >>>
# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Build + dependency output
node_modules/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets (never commit these)
.env
.env.*
!.env.example
# <<< managed-file-sync:common <<<

# >>> managed-file-sync:coverage_artifacts >>>
.coverage
.coverage.*
coverage.xml
htmlcov/
# <<< managed-file-sync:coverage_artifacts <<<
